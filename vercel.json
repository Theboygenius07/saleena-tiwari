{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [{ "source": "/", "destination": "/about" }],
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/pages/:name.html", "destination": "/:name", "permanent": true },
    { "source": "/pages/:name", "destination": "/:name", "permanent": true }
  ]
}
